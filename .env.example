# Copy to .env and fill in. Only DATABRICKS_HOST / DATABRICKS_TOKEN are
# required for local runs against a workspace; everything else has a default.
# On a Databricks cluster, HOST and TOKEN are injected automatically.

# ── Databricks workspace ──────────────────────────────────────────────
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Run mode ──────────────────────────────────────────────────────────
QC_ENV=local                 # local | databricks
QC_CATALOG=workspace
QC_SCHEMA=qc_schema
QC_LOG_TABLE=qc_audit_log
QC_GEOCODE_CACHE_TABLE=geocode_cache
QC_LOCAL_DATA_DIR=./data     # where local CSV fixtures / downloads land

# ── LLM (Databricks Model Serving, OpenAI-compatible) ─────────────────
DATABRICKS_LLM_MODEL=databricks-meta-llama-3-3-70b-instruct

# ── Geocoding ─────────────────────────────────────────────────────────
GEOCODER=nominatim
GEOCODER_USER_AGENT=databricks-qc-agent/1.0

# ── Public data ingestion (SEC EDGAR requires a real UA string) ───────
SEC_EDGAR_USER_AGENT=Your Name your.email@example.com

# ── MLflow (local only; on Databricks this is set for you) ────────────
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_ID=

# ── MCP server (HTTP mode only; not needed for stdio) ─────────────────
MCP_API_KEY=                 # 32+ char hex; generate: python -c "import secrets;print(secrets.token_hex(32))"
MCP_ALLOWED_IPS=             # comma-separated allowlist; empty = allow all
ENFORCE_HTTPS=false
